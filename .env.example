# The WP Engine install this repository deploys to. Copy to .env, fill in,
# and load before running anything under wp/ or elementor/:
#
#   cp .env.example .env
#   set -a; . ./.env; set +a
#
# .env is gitignored. Nothing here is a password: WP Engine SSH is key-only,
# and the key itself stays in ~/.ssh and is never committed.

# SSH user and host, as shown in the WP Engine dashboard under SSH Gateway.
export WPE_SSH_HOST=install@install.ssh.wpengine.net

# Private key to authenticate with. A leading ~/ is expanded; anything else
# is passed to `ssh -i` as given.
export WPE_SSH_KEY=~/.ssh/wpengine_ed25519

# Absolute path to the install's WordPress root on the server. WP Engine
# lays this out as /nas/content/live/<install-name>.
export WPE_ROOT=/nas/content/live/install-name
